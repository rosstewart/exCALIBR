\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Likelihood-ratio thresholds for evidence codes 1, 2, 4, 8 (Su, M, S, VS) vs.\ gene-specific prior. Standard (Tavtigian, solid): follows a single fixed relationship; shows a non-monotone artefact near $p \approx 0.25$ and a large spike at $p=0.45$ where benign combination rules drive $C^*$ to 2876. ACMG-Bayes (dashed): varies smoothly with the prior and produces exact posteriors at each evidence boundary. Warm colours = pathogenic codes; cool colours = benign codes.}}{9}{figure.1}}
\newlabel{fig:lr_thresholds}{{1}{9}{Likelihood-ratio thresholds for evidence codes 1, 2, 4, 8 (Su, M, S, VS) vs.\ gene-specific prior. Standard (Tavtigian, solid): follows a single fixed relationship; shows a non-monotone artefact near $p \approx 0.25$ and a large spike at $p=0.45$ where benign combination rules drive $C^*$ to 2876. ACMG-Bayes (dashed): varies smoothly with the prior and produces exact posteriors at each evidence boundary. Warm colours = pathogenic codes; cool colours = benign codes}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Posterior probability at each method's classification boundary vs.\ gene-specific prior. ACMG-Bayes (dashed): flat at all four targets by construction. Standard (Tavtigian, solid): well-calibrated for LP at priors $\leq 0.25$ but severely miscalibrated for LB and B across the full prior range, with anomalous over-calibration near $p \approx 0.45$.}}{9}{figure.2}}
\newlabel{fig:boundary_posteriors}{{2}{9}{Posterior probability at each method's classification boundary vs.\ gene-specific prior. ACMG-Bayes (dashed): flat at all four targets by construction. Standard (Tavtigian, solid): well-calibrated for LP at priors $\leq 0.25$ but severely miscalibrated for LB and B across the full prior range, with anomalous over-calibration near $p \approx 0.45$}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces $\qopname  \relax o{log}(\mathrm  {LR}^{+})$ vs.\ total evidence points at three prior values. Coloured dots mark the exact Bayesian target at each of the four classification boundaries. Standard (Tavtigian, red): a single straight line that passes through all four dots only at $p=0.10$. ACMG-Bayes (blue): a line that passes through all four dots at every prior by shifting vertically. Lower panels: the corresponding posterior probability curves.}}{10}{figure.3}}
\newlabel{fig:slope_geometry}{{3}{10}{$\log (\lrp )$ vs.\ total evidence points at three prior values. Coloured dots mark the exact Bayesian target at each of the four classification boundaries. Standard (Tavtigian, red): a single straight line that passes through all four dots only at $p=0.10$. ACMG-Bayes (blue): a line that passes through all four dots at every prior by shifting vertically. Lower panels: the corresponding posterior probability curves}{figure.3}{}}
