\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces ACMG/AMP combination rules in the modified Tavtigian point system \cite  {tavtigian2018modeling, Tavtigian2020}. Points: Su\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}1, M\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}2, S\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}4, VS\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}8; Su$_B$\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}$-1$, S$_B$\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}$-4$ (standard ACMG benign tiers only). $^\dagger $Modified rule: original ACMG classifies VS+M as LP and 2S as P; both are internally inconsistent at $p=0.10$, so following Tavtigian et al.\ they are swapped. All calculations use the modified (swapped) rules.}}{11}{table.5}}
\newlabel{tab:rules}{{5}{11}{ACMG/AMP combination rules in the modified Tavtigian point system \cite {tavtigian2018modeling, Tavtigian2020}. Points: Su\,=\,1, M\,=\,2, S\,=\,4, VS\,=\,8; Su$_B$\,=\,$-1$, S$_B$\,=\,$-4$ (standard ACMG benign tiers only). $^\dagger $Modified rule: original ACMG classifies VS+M as LP and 2S as P; both are internally inconsistent at $p=0.10$, so following Tavtigian et al.\ they are swapped. All calculations use the modified (swapped) rules}{table.5}{}}
\newlabel{sec:supplement}{{}{11}{Supplementary: combination error tables}{section*.19}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{Combination errors for all pathogenic code pairs. $k_A \leq k_B$, both in $\{1,2,3,4,5,6,7,8\}$. Codes 3,5,6,7 are intermediate strengths not corresponding to named ACMG tiers; codes 1,2,4,8 = Su, M, S, VS. PW = piecewise additivity error; Tav = Tavtigian posterior error. Both measured vs.\ the Bayesian posterior from the piecewise per-code LR$^+$ product.}}{11}{table.6}}
\newlabel{tab:s_path}{{6}{11}{Combination errors for all pathogenic code pairs. $k_A \leq k_B$, both in $\{1,2,3,4,5,6,7,8\}$. Codes 3,5,6,7 are intermediate strengths not corresponding to named ACMG tiers; codes 1,2,4,8 = Su, M, S, VS. PW = piecewise additivity error; Tav = Tavtigian posterior error. Both measured vs.\ the Bayesian posterior from the piecewise per-code LR$^+$ product}{table.6}{}}
